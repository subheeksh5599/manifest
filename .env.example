# RPC endpoint for reading mainnet state. Public endpoint requires a browser User-Agent.
RPC_URL=https://api.mainnet-beta.solana.com

# Fallback RPC (used if primary returns 403/5xx).
RPC_URL_FALLBACK=https://api.mainnet-beta.solana.com

# Browser User-Agent sent with every RPC request.
RPC_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Jupiter keyless swap-instructions endpoint.
JUP_URL=https://lite-api.jup.ag/swap/v1

# Default reference stablecoin mint (USDC on Solana mainnet).
INPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Guard program id (placeholder until deployed).
GUARD_PROGRAM_ID=Guard1111111111111111111111111111111111111
